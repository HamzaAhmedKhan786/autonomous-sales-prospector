# Autonomous Sales Prospector — copy to .env.local and fill in secrets. Never commit it.
# Production: inject secrets through the hosting secret manager, not Docker build arguments.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
PROFILE_API_URL=
PROFILE_API_KEY=
DATABASE_PATH=./data/prospector.db
APP_URL=http://localhost:3000
RESEARCH_RATE_LIMIT=20
EMAIL_DAILY_LIMIT=100
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
HUBSPOT_ACCESS_TOKEN=
CRM_API_URL=http://localhost:4100
NEXT_PUBLIC_CRM_APP_URL=http://localhost:4100
CRM_ORGANIZATION_ID=
# Must exactly match ASP_SHARED_SECRET in the CRM deployment.
ASP_SHARED_SECRET=
