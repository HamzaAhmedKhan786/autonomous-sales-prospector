# Autonomous Sales Prospector — copy to .env.local and fill in secrets. Never commit it.
# Production: inject secrets through the hosting secret manager, not Docker build arguments.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# groq uses the API key above. local permits loopback-only OpenAI-compatible servers such as Ollama.
LLM_PROVIDER=groq
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-only
LLM_MODEL=llama3.2
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
PROFILE_API_URL=
PROFILE_API_KEY=
DATABASE_PATH=./data/prospector.db
APP_URL=http://localhost:3000
RESEARCH_RATE_LIMIT=20
EMAIL_DAILY_LIMIT=100
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
HUBSPOT_ACCESS_TOKEN=
CRM_API_URL=http://localhost:4100
NEXT_PUBLIC_CRM_APP_URL=http://localhost:4100
CRM_ORGANIZATION_ID=
# Must exactly match ASP_SHARED_SECRET in the CRM deployment.
ASP_SHARED_SECRET=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional bearer token for /api/metrics. Set in production and configure Prometheus auth.
METRICS_TOKEN=
